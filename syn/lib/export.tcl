# ============================================================
# fi_export_scanmap -- after change_names
# ============================================================
# Must be after change_names -rules verilog, so the names written here
# are the ones that appear in the netlist you will simulate.
proc fi_export_scanmap {} {
    global FI_RESULTS_DIR FI_N_FF FI_SCAN_LEN FI_CHECK_OK FI_SCRUB_LEN

    set ok [expr {[info exists FI_CHECK_OK] && $FI_CHECK_OK}]

    set order [fi__scan_order]
    set L     [llength $order]
    if {[info exists FI_SCAN_LEN] && $FI_SCAN_LEN ne "" && $FI_SCAN_LEN != $L} {
        fi__msg FAIL "chain length changed from $FI_SCAN_LEN (when the invariants were checked) to\
                      $L (at export): the invariants were checked on another chain. Run\
                      fi_check_invariants after the last step that changes the netlist."
        set ok 0
        set FI_CHECK_OK 0
    }
    set FI_SCAN_LEN $L
    set w_idx [fi__clog2 $FI_N_FF]

    # (a) FI_Index -> flop, for picking targets and for reading waveforms.
    # Written even on a failed check -- it is a diagnostic, and you need
    # it to work out which block a stray flop belongs to.
    set f [open ${FI_RESULTS_DIR}/fi_scanmap.txt w]
    puts $f "# FI_Index\tcell"
    puts $f "# FI_Index is what you write into an FI_Entry. FI_Index 0 is the first"
    puts $f "# cell after scan-in; the executor flips FF\[FI_Index\] by inverting"
    puts $f "# scan_out at shift step L-1-FI_Index."
    puts $f "# L = $L"
    if {[info exists FI_SCRUB_LEN]} {
        puts $f "# K = $FI_SCRUB_LEN: FI_Index 0 .. K-1 hold every cell the DUT reset does not put back"
    }
    if {!$ok} {
        puts $f "# *** fi_check_invariants FAILED -- this chain is NOT safe to"
        puts $f "# *** inject into. Diagnostic use only."
    }
    set i 0
    foreach c $order { puts $f "$i\t$c" ; incr i }
    close $f

    # (b)+(c) the two files the sim and the host use: not written when the
    # invariants failed (the flow goes on after a failed check).
    if {!$ok} {
        fi__msg WARN "invariants failed -> NOT writing fi_scan_cfg.vh /\
                      fi_scan_cfg.tcl. Fix fi_scan_cfg.tcl and re-run;\
                      only fi_scanmap.txt was written, for diagnosis."
        return
    }

    # (b) RTL side: the wrapper's header, included from here by the simulation
    set f [open ${FI_RESULTS_DIR}/fi_scan_cfg.vh w]
    puts $f "\`ifndef FI_SCAN_CFG_VH"
    puts $f "\`define FI_SCAN_CFG_VH"
    puts $f ""
    puts $f "// GENERATED by syn/fi_scan_lib.tcl -- do not edit."
    puts $f "// FI_N_FF     encoding bound; only clog2() of it is used, so"
    puts $f "//             the FI_Entry field split does not move when L"
    puts $f "//             drifts across re-synthesis. Contract: L <= FI_N_FF-1."
    puts $f "// FI_SCAN_LEN measured chain length; informational, the"
    puts $f "//             executor uses the runtime CFG_SCAN_LEN (DMI 0x63)."
    puts $f "// FI_SCRUB_LEN shifts of the scrub at the end of a trial: the"
    puts $f "//             cells at FI_Index 0 .. K-1 are all those the DUT"
    puts $f "//             reset does not put back (fi_scan_ctrl SCRUB_LEN)."
    puts $f ""
    puts $f "\`define FI_N_FF        $FI_N_FF   // -> W_IDX = $w_idx"
    puts $f "\`define FI_SCAN_LEN    $L"
    puts $f "\`define FI_SCRUB_LEN   $FI_SCRUB_LEN"
    puts $f ""
    puts $f "\`endif"
    close $f

    # (c) host side: the file host/fi_openocd.cfg loads as FI_CFG
    set f [open ${FI_RESULTS_DIR}/fi_scan_cfg.tcl w]
    puts $f "# GENERATED by syn/fi_scan_lib.tcl -- do not edit."
    puts $f "set FI_SCAN_LEN $L"
    puts $f "set FI_SCRUB_LEN $FI_SCRUB_LEN"
    puts $f "set FI_W_IDX    $w_idx"
    close $f

    fi__msg INFO "exported ${FI_RESULTS_DIR}/fi_scanmap.txt (L=$L),\
                  fi_scan_cfg.vh, fi_scan_cfg.tcl"
}

# ============================================================
# fi_export_clock_gates -- after change_names
# ============================================================
# Every clock gate on any register's clock path, for whoever maps this
# netlist to an FPGA, where a gated clock becomes a clock enable on the
# flops behind the gate:
#   icg    CE = E | TE                (library ICG)
#   lgate  CE = the latch's D input   (latch + AND written in RTL)
#   fi     CE = ~(gate_q & clk_gate)  (FIawase's freeze; fi_wrapper_top run_o)
# Gates in series multiply. One line per gate:
#   kind  cell  root  registers-behind  enable  test/latch-input
# where enable and test name the drivers of those pins.
proc fi_export_clock_gates {} {
    global FI_RESULTS_DIR
    array set latches {}
    foreach n [get_object_name [all_registers -level_sensitive]] { set latches($n) 1 }
    array set seen {}
    array set gate {}
    array set behind {}
    array set groot {}
    foreach_in_collection r [all_registers] {
        foreach_in_collection cp [fi__clock_pins_of $r] {
            set key [fi__net_key $cp]
            if {![info exists seen($key)]} { set seen($key) [fi__clock_path $cp latches] }
            lassign $seen($key) root steps
            foreach st $steps {
                if {[lindex $st 0] eq "buf"} { continue }
                set g [lindex $st 1]
                set gate($g) $st
                set groot($g) $root
                if {![info exists behind($g)]} { set behind($g) 0 }
                incr behind($g)
            }
        }
    }
    set f [open ${FI_RESULTS_DIR}/fi_clock_gates.txt w]
    puts $f "# GENERATED by syn/fi_scan_lib.tcl -- every clock gate on a register's clock path."
    puts $f "# On an FPGA each becomes a clock enable on the flops behind it:"
    puts $f "#   icg: CE = E | TE   lgate: CE = the latch's D   fi: CE = ~(gate_q & clk_gate)"
    puts $f "# Gates in series multiply."
    puts $f "# kind\tcell\troot\tregisters\tenable\ttest-or-latch-input"
    foreach g [lsort [array names gate]] {
        set st $gate($g)
        set k  [lindex $st 0]
        set en "-" ; set te "-"
        if {$k eq "icg"} {
            set en [fi__net_key [get_pins [lindex $st 2]]]
            set te [fi__net_key [get_pins [lindex $st 3]]]
        } elseif {$k eq "lgate"} {
            set en [lindex $st 2]
            set l  [get_cells [lindex $st 2]]
            set lcn [get_object_name [get_lib_cells -of_objects $l]]
            foreach_in_collection p [get_pins -quiet -of_objects $l -filter "pin_direction == in"] {
                if {[get_attribute -quiet [get_lib_pins -quiet $lcn/[file tail [get_object_name $p]]] is_clock_pin] ne "true"} {
                    set te [fi__net_key $p]
                }
            }
        }
        puts $f "$k\t$g\t$groot($g)\t$behind($g)\t$en\t$te"
    }
    close $f
    fi__msg INFO "exported ${FI_RESULTS_DIR}/fi_clock_gates.txt ([array size gate] gate(s))"
}

# ============================================================
# fi_report -- last
# ============================================================
# The top ports DFT insertion created (FI_DFT_PORTS, taken right after
# insert_dft), e.g. AutoFix's test data source, with the value the test
# protocol's test_setup gives each: a testbench or FPGA top must drive them so.
proc fi__report_dft_ports {} {
    global FI_DFT_PORTS FI_RESULTS_DIR FI_OUT_SPF
    if {![info exists FI_DFT_PORTS]} { return }
    set new $FI_DFT_PORTS
    array set val {}
    if {[info exists FI_OUT_SPF] && [file exists $FI_RESULTS_DIR/$FI_OUT_SPF]} {
        set f [open $FI_RESULTS_DIR/$FI_OUT_SPF] ; set t [read $f] ; close $f
        set i [string first "\"test_setup\"" $t]
        if {$i >= 0} {
            foreach {- n v} [regexp -all -inline {"([^"]+)"\s*=\s*([01]);} [string range $t $i end]] {
                if {![info exists val($n)]} { set val($n) $v }
            }
        }
    }
    puts " ports DFT insertion created (drive them as the test setup does):"
    if {![llength $new]} { puts "   (none)" }
    foreach p $new { puts "   $p = [expr {[info exists val($p)] ? $val($p) : {? (not in the test setup)}}]" }
}

proc fi_report {} {
    global FI_RESULTS_DIR FI_FROZEN_PINS FI_EXEMPT FI_EXEMPT_CLOCKS
    global FI_GATE_NET FI_GATE_INST
    global FI_SCAN_LEN FI_N_FF FI_CHECK_SUMMARY FI_CHECK_OK FI_SCRUB_LEN

    if {![info exists FI_SCAN_LEN]}      { set FI_SCAN_LEN      "(not measured)" }
    if {![info exists FI_SCRUB_LEN]}     { set FI_SCRUB_LEN     "(not measured)" }
    if {![info exists FI_CHECK_SUMMARY]} { set FI_CHECK_SUMMARY "(not checked)" }
    set ok [expr {[info exists FI_CHECK_OK] && $FI_CHECK_OK}]

    # The bare token on its own line is what `make dc` and a CI wrapper grep
    # for; the banner is for a human.
    puts ""
    puts [expr {$ok ? "FI-PASS: scan invariants hold" \
                    : "FI-FAIL: scan invariants violated"}]
    puts "============================================================"
    if {$ok} {
        puts " FI INVARIANTS: PASS -- this netlist is safe to inject into"
    } else {
        puts " FI INVARIANTS: **FAIL** -- do NOT use this netlist for FI."
        puts " fi_scan_cfg.vh / fi_scan_cfg.tcl were not written."
        puts " Scroll up for the FI-FAIL lines; they say what to change in"
        puts " the port's fi_scan_cfg.tcl. (dc_shell does not stop on a Tcl"
        puts "  error, so everything below this ran anyway.)"
    }
    puts "============================================================"
    puts " FI scan configuration report"
    puts "============================================================"
    puts [format " %-22s %s" "gate instance"   $FI_GATE_INST]
    puts [format " %-22s %s" "gated clock net" $FI_GATE_NET]
    puts [format " %-22s %s" "chain length L"  $FI_SCAN_LEN]
    puts [format " %-22s %s" "scrub shifts K"  $FI_SCRUB_LEN]
    puts [format " %-22s %s" "FI_N_FF / W_IDX" \
              "$FI_N_FF / [fi__clog2 $FI_N_FF]"]
    puts [format " %-22s %s" "invariants"      $FI_CHECK_SUMMARY]
    fi__report_dft_ports
    puts " frozen clock pins:"
    if {[info exists FI_FROZEN_PINS]} { foreach p $FI_FROZEN_PINS { puts "   $p" } }
    puts " exempt instances:"
    foreach i $FI_EXEMPT        { puts "   $i" }
    puts " exempt clocks:"
    foreach c $FI_EXEMPT_CLOCKS { puts "   $c" }
    puts " artefacts in ${FI_RESULTS_DIR}:"
    puts "   fi_scanmap.txt      FI_Index -> flop"
    if {$ok} {
        puts "   fi_scan_cfg.vh      the wrapper's header (FI_N_FF, FI_SCAN_LEN, FI_SCRUB_LEN)"
        puts "   fi_scan_cfg.tcl     the same values for the host (FI_CFG)"
    } else {
        puts "   fi_scan_cfg.vh      NOT WRITTEN (invariants failed)"
        puts "   fi_scan_cfg.tcl     NOT WRITTEN (invariants failed)"
    }
    puts "   fi_scan_path.rpt    raw report_scan_path"
    puts "   fi_clock_gates.txt  every clock gate, as clock enables for an FPGA"
    puts "============================================================"
    puts ""
    # The gated branch inherits the clock through the gate; a
    # create_generated_clock is needed only if it is missing here.
    report_clocks
}
